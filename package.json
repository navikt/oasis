{
  "name": "oasis",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "license": "MIT",
  "engineStrict": true,
  "engines": {
    "node": "24"
  },
  "scripts": {
    "test": "yarn workspaces foreach -Ap --no-private run test --run",
    "lint": "biome check",
    "lint:ci": "biome ci",
    "build": "yarn workspaces foreach -At --no-private run build",
    "tsc": "yarn workspaces foreach -Ap run type-check",
    "postinstall": "husky"
  },
  "workspaces": [
    "libs/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1"
  }
}
