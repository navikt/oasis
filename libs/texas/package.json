{
  "name": "@navikt/texas",
  "version": "4.1.0",
  "license": "MIT",
  "description": "An even simpler client that wraps fetch and provides proper types for using nais/texas directly.",
  "engineStrict": true,
  "engines": {
    "node": "^20.19.0 || >= 22.12.0 || 24.x || 25.x"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com/"
  },
  "type": "module",
  "files": [
    "package.json",
    "dist"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "biome check",
    "test": "vitest",
    "tsc": "tsc --pretty",
    "gen:texas": "openapi-ts && biome format --write src/types.gen.ts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^25.9.5",
    "nock": "^14.0.17",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
